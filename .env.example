# --- Required ---
# Discord bot token (Developer Portal → Bot → Reset Token)
DISCORD_TOKEN=your-bot-token-here
# DeepSeek API key (platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# --- Discord ---
# Prefix for text commands (!ask, !clear, ...)
BOT_PREFIX=!
# Status line shown under the bot's name
BOT_STATUS=DeepSeek — /ask or @mention me
# Comma-separated channel/thread IDs where the bot answers every message (no mention needed)
ALLOWED_CHANNELS=

# --- DeepSeek API ---
DEEPSEEK_BASE_URL=https://api.deepseek.com
# deepseek-chat (default) or deepseek-reasoner
DEEPSEEK_MODEL=deepseek-chat
# Seconds to wait for the API before timing out
REQUEST_TIMEOUT_SECONDS=60
# OpenAI SDK auto-retries transient failures up to this many times
MAX_RETRIES=2

# --- Conversation behaviour ---
# Rolling history kept per channel/thread
MAX_CONTEXT_MESSAGES=20
# Max tokens per reply
MAX_TOKENS=2048
# Creativity (0.0 strict → 1.0 creative)
TEMPERATURE=0.7
# Live-edit streaming replies; set false for typing-indicator + buffered replies
STREAM_RESPONSES=true
# Override the AI's system prompt (optional). Leave commented out for the built-in persona.
# SYSTEM_PROMPT=

# --- Rate limiting ---
# Max prompts a single user may send per sliding window (0 disables)
ASK_COOLDOWN_RATE=5
ASK_COOLDOWN_PERIOD_SECONDS=60
